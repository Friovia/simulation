// 器件族：主流液冷服务器冷板组（NVIDIA HGX H100/H200、GB200 NVL72、OCP OAM）
// 数据政策见 schema.md：无源不入库、绝不编数；单点数据按政策#2借同类形状插值
// （微通道冷板充分发展湍流区 ΔP∝Q^~1.5-2，本文件统一按注明的方式插值）。
// 热阻 θ 数据仅记于 notes，主要供 P1 热链用，不参与水力曲线。
// 检索日期统一 retrieved: 2026-10-17
[
  // ── OCP OAI 规格系（8-OAM / H100 级加速模块冷板组）──────────────────────────
  {
    // OAI《System Liquid Cooling Guidelines》(2023-03, Meta/Microsoft/Intel/Wiwynn/Boyd 等)
    // §6.1 Boyd 案例：4x2 布局 8-OAM PCL 整链（QD-to-QD，含分液 manifold + 8 冷板并联）
    "id": "coldplate-oai-8oam-4x2-pcl-pg25",
    "type": "cold-plate",
    "vendor": "OCP OAI (Boyd 案例)",
    "model": "8-OAM PCL 4x2 (QD-to-QD 整链)",
    "fluid": { "basis": "PG25（25% 丙二醇水溶液）" },
    "curve": {
      "x": "L/min",
      "y": "kPa",
      // 锚点：10.0 L/min @ 10 psi(=68.9 kPa)（原文固定流量扫点）。其余点按 ΔP=k·Q² 插值
      "points": [[6, 24.8], [8, 44.1], [10, 68.9], [12, 99.2], [14, 135.7]]
    },
    "source": {
      "url": "https://www.opencompute.org/documents/oai-system-liquid-cooling-guidelines-in-ocp-template-mar-3-2023-update-pdf",
      "type": "ocp-spec",
      "retrieved": "2026-10-17"
    },
    "uncertainty": "OCP 白皮书案例数据（原型 PCL，非量产 datasheet）；额定单点锚定（10 L/min, 68.9 kPa），其余点形状借自同类（湍流二次律），绝对值有据",
    "redlight": null,
    "notes": "需水量口径：OAI 指南 §1.3 给出每 OAM 冷板典型 1-2 L/min、机箱级 8 OAM 4-16 L/min；PG25 设计准则 1.25-2.0 L/min/kW（对应温升 7.5-12°C）。PCL 整链含 manifold+快插，冷板本体 ΔP 占比约 50%（另见 Wiwynn 案例）。θ 数据（主要供 P1 热链用）：CoolerMaster 1kW OAM TTV θ<0.02 °C/W @ PG25 2-5 L/min。系统背景：OCP ACS 冷板需求文档（https://www.opencompute.org/documents/ocp-acs-liquid-cooling-cold-plate-requirements-pdf）给出 TCS 回路工作压力典型 140-450 kPa、冷板带走热量占比 70-75%。"
  },
  {
    // 同文档 §6.1：8x1 布局。有两个真实锚点：(10 L/min, 7 psi=48.3 kPa) 与 (12.5 L/min, 10 psi=68.9 kPa)
    "id": "coldplate-oai-8oam-8x1-pcl-pg25",
    "type": "cold-plate",
    "vendor": "OCP OAI (Boyd 案例)",
    "model": "8-OAM PCL 8x1 (QD-to-QD 整链)",
    "fluid": { "basis": "PG25（25% 丙二醇水溶液）" },
    "curve": {
      "x": "L/min",
      "y": "kPa",
      // 两锚点间幂律指数 n=1.56（由两锚点反解），区间外外推
      "points": [[6, 21.8], [8, 33.9], [10, 48.3], [12.5, 68.9], [14, 82.7]]
    },
    "source": {
      "url": "https://www.opencompute.org/documents/oai-system-liquid-cooling-guidelines-in-ocp-template-mar-3-2023-update-pdf",
      "type": "ocp-spec",
      "retrieved": "2026-10-17"
    },
    "uncertainty": "OCP 白皮书案例数据；两个真实锚点（10 L/min@48.3 kPa、12.5 L/min@68.9 kPa）间幂律 n=1.56 内插，锚点外形状借自同类，绝对值有据",
    "redlight": null,
    "notes": "8x1 布局阻力低于 4x2（同 10 psi 下流量 12.5 vs 10.0 L/min）。需水量/θ 参见 4x2 条目 notes。"
  },
  {
    // 同文档 §6.3：Wiwynn 4x2 8-OAM TTV 系统验证（DI 水基准，与 PG25 条目分开立）
